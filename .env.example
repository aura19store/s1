# ==============================================================================
# AURA Store — Environment Variables Template
# Copy this file to .env.local for local overrides or configure these variables
# in your production hosting provider (e.g. Vercel / Supabase).
# NEVER commit real secrets or .env.local to Git.
# ==============================================================================

# Public site URL used for sitemap & canonical metadata (optional)
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database
# When DATABASE_URL is set, AURA uses Supabase PostgreSQL automatically.
# When DATABASE_URL is unset, AURA preserves & uses local SQLite (data/aura.db).
# ------------------------------------------------------------------------------
DATABASE_URL=
# Optional direct (non-pooled) connection string for migrations / CLI seeding
DIRECT_URL=

# ------------------------------------------------------------------------------
# Supabase Storage (Product & Media Uploads)
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, admin media uploads
# store images in Supabase Storage. When unset, local public/uploads/ is used.
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name (must exist and be configured as public for storefront reads)
SUPABASE_STORAGE_BUCKET=aura-media

# ------------------------------------------------------------------------------
# Initial Admin Seeding (Required ONLY when running `npm run seed`)
# ------------------------------------------------------------------------------
ADMIN_SEED_PASSWORD=
